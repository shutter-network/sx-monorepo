# Hub operator environment — used with docker-compose.yml
# Copy to .env and fill in real values before starting.

# --- Snapshot services -------------------------------------------------------
# Signs sequencer receipts. Not a funded wallet; a throwaway is fine locally.
SEQ_RELAYER_PK=0x...
SEQ_AUTH_SECRET=1dfd84a695705665668c260222ded178d1f1d62d251d7bee8148428dac6d0487
WALLETCONNECT_PROJECT_ID=e6454bd61aba40b786e866a69bd4c5c6

# The sequencer's credential-issuing key. It signs one credential per private
# ballot at ingest, binding the voting power that ballot is counted with.
#   python3 -c "import secrets; print('0x'+secrets.token_bytes(32).hex())"
# The sequencer cannot accept private votes without it.
# Rotating it invalidates every credential on every existing private proposal,
# and those tallies then read as all zeros.
TE_ELIGIBILITY_PRIVATE_KEY=0x...

# One URL per committee member. The sequencer
# reads each keyper's signing address from its own /status when it freezes a
# committee onto a proposal, and refuses two URLs that report the same address.
# A keyper that cannot be reached fails proposal creation, because
# the DKG needs every member and would fail anyway -- later, and terminally.
TE_KEYPERS=https://keyper1.example,https://keyper2.example,https://keyper3.example

# Threshold config. TE_THRESHOLD_T is the quorum -- the number of keypers that
# must act together (t of n), not the number of faults tolerated. It must be a
# strict majority of the committee, so 3 keypers means 2.
TE_THRESHOLD_T=2

# The coordinator's address. It signs the published result and the hub accepts one
# from no other key. This is the address of the coordinator's own signing key,
# which lives only in the coordinator's env file.
TE_RESULT_PUBLISHER_ADDRESS=0x...


# Denominator for weighted vote splits: 100 means percentages.
TE_WEIGHTED_BUDGET=100

# How large a discrete-log search this deployment's coordinator can solve:
# `budget x sum(admitted weights)`. **Set this to match your coordinator's RAM** --
# it is a statement about hardware, not a preference, and it is the only knob that
# moves the bound.
#
# Every private proposal derives its `scale` from it: `scale` is the smallest power
# of two with `budget x (V / scale) <= TE_SOLVER_CEILING`, and a proposal that scales
# divides every voter's power. So understating this scales proposals that did not
# need it, and overstating it sizes a tally the machine cannot finish.
#
# The default is deliberately small -- 1e12 is roughly a 0.5 GB coordinator (~220 MB
# table, ~22 s tally), well under the 2 GB that suits most deployments. Left alone,
# spaces above 1e10 whole tokens of supply scale when they need not.
#
#   1 GB -> 1.3e13     4 GB -> 2.0e14     16 GB -> 3.3e15
#   2 GB -> 5.1e13     8 GB -> 8.2e14     32 GB -> 1.3e16
#
# Full table, and a script to re-derive it on your own hardware, in
# docs/private-voting/README.md ("Coordinator sizing").
TE_SOLVER_CEILING=1e12

# DKG lead time (seconds before proposal start that DKG must complete)
MIN_DKG_LEAD_TIME_S=180

# Where the browser should reach the sequencer. The hub 307-redirects
# /api/scores/:id here, and the UI calls that to finalise a closed proposal's
# scores -- so it must resolve in the *browser*, not just inside the compose
# network. Defaults to http://localhost:${SEQ_PORT:-3001}; set it to your public
# sequencer URL in a real deployment.
# SEQUENCER_PUBLIC_URL=https://seq.example.org

# --- Optional: ports and logging --------------------------------------------
# All have working defaults in docker-compose.yml; set them only to avoid a clash
# with something already running on this machine.
# MYSQL_PORT=3306
# HUB_PORT=3000
# SEQ_PORT=3001
# TE_DATA_LAYER_PORT=3002
# TE_DATA_LAYER_LOG_LEVEL=info
